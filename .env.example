SERVER_NAME=server1
BACKUP_ROOT=/srv
DOWNLOAD_DIR=/downloads
TIMEZONE=Europe/Helsinki

S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=my-backups
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_PATH_STYLE=true

MAX_FILE_SIZE_MB=10
MAX_DIR_FILE_COUNT=2000
RETENTION_KEEP=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# host-side only, used by docker-compose.yml
BACKUP_SOURCE_DIR=/srv
