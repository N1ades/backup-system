# identity
SERVER_NAME=server1
TIMEZONE=Europe/Moscow

# paths inside the container (leave as-is unless you changed the compose mounts)
BACKUP_ROOT=/srv
RESTORE_ROOT=/restore

# S3 / Cloudflare R2 (R2 speaks the S3 API, so this works for both)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=my-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# audit thresholds: an *unmarked* dir bigger than this (or with more files
# than this) is skipped and flagged in the audit instead of being backed up
AUDIT_MAX_DIR_MB=10
AUDIT_MAX_DIR_FILES=1000
# an included file bigger than this gets flagged in the audit as "large" (informational only)
AUDIT_WARN_FILE_MB=50

RETENTION_DAYS=30

# fallback schedule for projects that don't set their own `#cron:` in .backup
# (standard 5-field cron syntax; checked every minute, per-project)
BACKUP_CRON=0 3 * * *

# telegram notifications (optional - leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
